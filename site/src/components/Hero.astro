---
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  heading: string;
  emphasis: string;
  subtitle: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  mediaNote: string;
}

const {
  eyebrow,
  heading,
  emphasis,
  subtitle,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  mediaNote,
} = Astro.props;
---

<div class="mx-auto flex max-w-container flex-wrap items-center gap-[72px] px-gutter pt-[88px] pb-20">
  <div class="min-w-0 flex-[1_1_430px]">
    <p
      class="inline-flex items-center gap-2.5 font-display text-xs font-bold uppercase tracking-[.14em] text-teal-700 before:h-0.5 before:w-7 before:bg-amber-500 before:content-['']"
    >
      {eyebrow}
    </p>
    <h1 class="mt-5 font-display text-[38px] font-black leading-[1.08] text-navy-800 sm:text-[48px] lg:text-[60px]">
      {heading}<br />
      <em class="not-italic text-amber-600">{emphasis}</em>
    </h1>
    <p class="mt-[22px] max-w-[560px] text-[19px] leading-relaxed text-navy-800">{subtitle}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={primaryHref} variant="primary">{primaryLabel}</Button>
      <Button href={secondaryHref} variant="outline">{secondaryLabel}</Button>
    </div>
  </div>

  <div class="min-w-0 flex-[1_1_400px]">
    <div class="flex aspect-[4/3] flex-col items-center justify-center gap-3 rounded-lg border border-salt-300 bg-white p-8 text-center shadow-sm">
      <div class="h-[88px] w-[88px] rounded-lg border border-teal-300 bg-teal-100"></div>
      <p class="font-display text-xs font-bold uppercase tracking-[.14em] text-teal-700">Photo placeholder · 4:3</p>
      <p class="max-w-[300px] text-[15px] leading-relaxed text-salt-600">{mediaNote}</p>
    </div>
  </div>
</div>
