---
import Spot from './Spot.astro';

interface Props {
  icon?: string;
  tone?: 'amber' | 'sea' | 'deep';
  num?: string;
  title: string;
  row?: boolean;
  accent?: boolean;
  small?: boolean;
  titleClass?: string;
  class?: string;
}

const { icon, tone = 'amber', num, title, row = false, accent = false, small = false, titleClass = '', class: className = '' } = Astro.props;
const titleSize = titleClass || (small ? 'text-[19px]' : row ? 'text-[20px]' : '');
---

<article
  class={`flex gap-4 rounded-lg border border-salt-200 bg-white p-6 shadow-xs md:p-8 ${row ? 'flex-col md:flex-row md:items-start md:gap-5' : 'flex-col'} ${accent ? 'border-t-[3px] border-t-amber-500' : ''} ${className}`}
>
  {
    row ? (
      <>
        {icon && <Spot icon={icon} tone={tone} />}
        <div class="flex min-w-0 flex-col gap-2.5">
          <h3 class={`h3 ${titleSize}`}>{title}</h3>
          <p class="text-[17px] leading-[1.65]"><slot /></p>
        </div>
      </>
    ) : small ? (
      <>
        <div class="flex items-center gap-3.5">
          {icon && <Spot icon={icon} tone={tone} small />}
          <h3 class={`h3 ${titleSize}`}>{title}</h3>
        </div>
        <p class="text-[17px] leading-[1.65]"><slot /></p>
      </>
    ) : (
      <>
        {(icon || num) && (
          <div class="flex items-center justify-between gap-4">
            {icon && <Spot icon={icon} tone={tone} />}
            {num && <span class="num">{num}</span>}
          </div>
        )}
        <h3 class={`h3 ${titleSize}`}>{title}</h3>
        <p class="text-[17px] leading-[1.65]"><slot /></p>
      </>
    )
  }
</article>
