---
interface Review {
  quote: string;
  name: string;
  suburb: string;
}

interface Props {
  reviews: Review[];
  class?: string;
}

const { reviews, class: className = '' } = Astro.props;
---

<div class={`mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 ${className}`}>
  {reviews.map((review) => (
    <blockquote class="rounded-lg border border-salt-200 bg-white p-8 shadow-xs">
      <div class="flex gap-1 text-amber-500" aria-hidden="true">★★★★★</div>
      <p class="mt-4 text-[17px] leading-relaxed text-navy-800">{review.quote}</p>
      <p class="mt-[18px] font-display text-[13px] font-bold uppercase tracking-[.14em] text-salt-500">
        {review.name} · {review.suburb}
      </p>
    </blockquote>
  ))}
</div>
