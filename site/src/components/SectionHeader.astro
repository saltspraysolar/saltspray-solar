---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  light?: boolean;
  class?: string;
}

const { eyebrow, title, description, light = false, class: className = '' } = Astro.props;
---

<div class={`max-w-[760px] ${className}`}>
  <p class={`eyebrow ${light ? 'eyebrow-deep' : ''}`}>{eyebrow}</p>
  <h2 class={`h2 ${light ? 'h2-light' : ''}`}>{title}</h2>
  {description && <p class={`lede ${light ? 'lede-light' : ''}`}>{description}</p>}
</div>
