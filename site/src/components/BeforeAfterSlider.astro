---
// Reusable drag-to-compare slider. Swap the `examples` prop for real photo
// pairs once they exist — the label/before/after/stat/reading text is all
// that needs to change.
interface Example {
  label: string;
  before: string;
  after: string;
  stat: string;
  reading: string;
}

interface Props {
  examples: Example[];
}

const { examples } = Astro.props;
const first = examples[0];
---

<div data-ba-root data-examples={JSON.stringify(examples)}>
  <div class="flex flex-wrap gap-2.5" role="group" aria-label="Choose an example">
    {examples.map((ex, i) => (
      <button
        type="button"
        class="h-10 rounded-md border border-salt-300 bg-white px-[18px] font-display text-[15px] font-bold text-navy-800 aria-pressed:border-teal-300 aria-pressed:bg-teal-100 aria-pressed:text-teal-700"
        aria-pressed={i === 0 ? 'true' : 'false'}
        data-ba-example={i}
      >
        {ex.label}
      </button>
    ))}
  </div>

  <div class="mt-6 flex flex-wrap items-start gap-6">
    <div class="min-w-0 flex-[1_1_460px]">
      <div
        class="relative aspect-[16/10] cursor-ew-resize touch-none select-none overflow-hidden rounded-lg border border-salt-300 bg-salt-50 shadow-sm"
        data-ba-slider
      >
        <div class="absolute inset-0 flex flex-col items-start gap-2 bg-salt-100 p-6">
          <p class="font-display text-xs font-bold uppercase tracking-[.14em] text-salt-600">Before photo · 16:10</p>
          <p class="max-w-[210px] text-[15px] leading-snug text-salt-600" data-ba-before>{first.before}</p>
        </div>
        <div
          class="absolute inset-0 flex flex-col items-end gap-2 bg-teal-100 p-6 text-right"
          style="clip-path: inset(0 0 0 50%)"
          data-ba-after-pane
        >
          <p class="font-display text-xs font-bold uppercase tracking-[.14em] text-teal-700">After photo · 16:10</p>
          <p class="max-w-[210px] text-[15px] leading-snug text-teal-700" data-ba-after>{first.after}</p>
        </div>
        <div class="absolute bottom-0 top-0 w-0.5 bg-white" style="left: 50%" data-ba-line></div>
        <div
          class="absolute top-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-pill border border-salt-300 bg-white font-bold text-navy-800 shadow-sm"
          style="left: 50%"
          data-ba-handle
        >
          ›
        </div>
        <span class="absolute bottom-3 left-3.5 font-display text-[11px] font-bold uppercase tracking-[.14em] text-navy-800">Before</span>
        <span class="absolute bottom-3 right-3.5 font-display text-[11px] font-bold uppercase tracking-[.14em] text-teal-700">After</span>
      </div>
    </div>
    <div class="flex min-w-0 flex-[1_1_260px] flex-col gap-6">
      <div>
        <p class="font-display text-5xl font-black leading-none tracking-[-0.03em] text-navy-800" data-ba-stat>{first.stat}</p>
        <p class="mt-2 text-[15px] text-salt-600">Output recovered on this job</p>
      </div>
      <p class="font-mono text-[17px] text-teal-700" data-ba-reading>{first.reading}</p>
      <slot />
    </div>
  </div>
</div>

<script>
  interface Example {
    label: string;
    before: string;
    after: string;
    stat: string;
    reading: string;
  }

  document.querySelectorAll<HTMLElement>('[data-ba-root]').forEach((root) => {
    const examples: Example[] = JSON.parse(root.dataset.examples ?? '[]');
    const slider = root.querySelector<HTMLElement>('[data-ba-slider]');
    if (!slider) return;

    const afterPane = slider.querySelector<HTMLElement>('[data-ba-after-pane]');
    const line = slider.querySelector<HTMLElement>('[data-ba-line]');
    const handle = slider.querySelector<HTMLElement>('[data-ba-handle]');
    let dragging = false;

    const setPct = (pct: number) => {
      const clamped = Math.max(0, Math.min(100, pct));
      if (afterPane) afterPane.style.clipPath = `inset(0 0 0 ${clamped}%)`;
      if (line) line.style.left = `${clamped}%`;
      if (handle) handle.style.left = `${clamped}%`;
    };

    const fromEvent = (e: PointerEvent) => {
      const rect = slider.getBoundingClientRect();
      setPct(((e.clientX - rect.left) / rect.width) * 100);
    };

    slider.addEventListener('pointerdown', (e) => {
      dragging = true;
      slider.setPointerCapture(e.pointerId);
      fromEvent(e);
    });
    slider.addEventListener('pointermove', (e) => {
      if (dragging) fromEvent(e);
    });
    slider.addEventListener('pointerup', () => {
      dragging = false;
    });

    root.querySelectorAll<HTMLButtonElement>('[data-ba-example]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const example = examples[Number(btn.dataset.baExample)];
        if (!example) return;

        root.querySelectorAll<HTMLButtonElement>('[data-ba-example]').forEach((b) => {
          b.setAttribute('aria-pressed', String(b === btn));
        });

        const beforeEl = root.querySelector('[data-ba-before]');
        const afterEl = root.querySelector('[data-ba-after]');
        const statEl = root.querySelector('[data-ba-stat]');
        const readingEl = root.querySelector('[data-ba-reading]');

        if (beforeEl) beforeEl.textContent = example.before;
        if (afterEl) afterEl.textContent = example.after;
        if (statEl) statEl.textContent = example.stat;
        if (readingEl) readingEl.textContent = example.reading;

        setPct(50);
      });
    });
  });
</script>
