---
// Built natively with text + CSS (no imported SVG wordmark, per brand build rules).
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}

const { variant = 'light', class: className = '' } = Astro.props;
const textColor = variant === 'light' ? 'text-white' : 'text-navy-800';
---

<a href="/" class={`inline-flex items-center gap-2.5 ${className}`} aria-label="SaltSpray Solar — home">
  <span
    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-amber-500 font-display text-sm font-black leading-none text-navy-900"
    aria-hidden="true"
  >
    S
  </span>
  <span class={`font-display text-[19px] font-black tracking-[-0.028em] ${textColor}`}>
    Salt<span class="text-amber-400">Spray</span> Solar
  </span>
</a>
