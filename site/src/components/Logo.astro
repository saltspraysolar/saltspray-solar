---
// Mark = droplet with a sun inside (shapes only, no SVG text); wordmark = real text styled with CSS.
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}

const { variant = 'light', class: className = '' } = Astro.props;
const textColor = variant === 'light' ? 'text-white' : 'text-navy-800';
---

<a href="/" class={`inline-flex items-center gap-2.5 ${className}`} aria-label="Salt Spray Solar — home">
  <svg width="34" height="34" viewBox="0 0 64 64" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <path d="M32 5C32 5 51 24.5 51 39A19 19 0 1 1 13 39C13 24.5 32 5 32 5Z" fill="#FFFFFF"></path>
    <g stroke="#F5A524" stroke-width="2.6" stroke-linecap="round">
      <line x1="43.5" y1="40" x2="47" y2="40"></line>
      <line x1="40.13" y1="48.13" x2="42.61" y2="50.61"></line>
      <line x1="32" y1="51.5" x2="32" y2="55"></line>
      <line x1="23.87" y1="48.13" x2="21.39" y2="50.61"></line>
      <line x1="20.5" y1="40" x2="17" y2="40"></line>
      <line x1="23.87" y1="31.87" x2="21.39" y2="29.39"></line>
      <line x1="32" y1="28.5" x2="32" y2="25"></line>
      <line x1="40.13" y1="31.87" x2="42.61" y2="29.39"></line>
    </g>
    <circle cx="32" cy="40" r="7.5" fill="#F5A524"></circle>
  </svg>
  <span class={`font-display text-[19px] font-black tracking-[-0.028em] ${textColor}`}>
    Salt<span class="text-amber-400">Spray</span> Solar
  </span>
</a>
