---
interface Props {
  badges: string[];
  class?: string;
}

const { badges, class: className = '' } = Astro.props;
---

<div class={`border-t border-sand-200 ${className}`}>
  <div class="mx-auto flex max-w-container flex-wrap gap-2.5 px-gutter py-7">
    {badges.map((label) => (
      <span
        class="inline-flex h-[30px] items-center gap-2 rounded-sm border border-salt-300 bg-white px-3 font-display text-[13px] font-bold text-navy-800"
      >
        {label}
      </span>
    ))}
  </div>
</div>
