---
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'inverse';
  block?: boolean;
  class?: string;
}

const { href, variant = 'primary', block = false, class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  primary: 'border-amber-500 bg-amber-500 text-navy-900 hover:border-amber-400 hover:bg-amber-400 active:bg-amber-600',
  outline: 'border-navy-800 bg-transparent text-navy-800 hover:bg-salt-100',
  inverse: 'border-white bg-white text-navy-900 hover:border-salt-100 hover:bg-salt-100',
};
---

<a
  href={href}
  class={`${block ? 'flex w-full' : 'inline-flex w-full sm:w-auto'} min-h-[54px] items-center justify-center gap-2.5 rounded-md border-2 px-[26px] py-3.5 text-center font-display text-base font-bold leading-[1.3] tracking-[0.01em] transition-colors duration-150 ${variants[variant]} ${className}`}
>
  <slot />
</a>
