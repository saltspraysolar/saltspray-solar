---
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'inverse';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  primary: 'bg-amber-500 text-navy-900 hover:bg-amber-400 active:bg-amber-600',
  outline: 'bg-transparent text-navy-800 border-2 border-navy-800 hover:bg-salt-100',
  inverse: 'bg-transparent text-white border-2 border-white/40 hover:bg-white/10',
};
---

<a
  href={href}
  class={`inline-flex h-[54px] items-center gap-2.5 rounded-md px-[26px] font-display text-[15px] font-bold tracking-[0.01em] transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-500 focus-visible:outline-offset-2 ${variants[variant]} ${className}`}
>
  <slot />
</a>
