---
import Button from './Button.astro';

interface Props {
  title: string;
  description: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
}

const { title, description, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section
  class="bg-navy-900 text-white"
  style="background-image: repeating-conic-gradient(from 0deg at 50% 100%, rgba(245,165,36,.18) 0deg 3deg, transparent 3deg 9deg);"
>
  <div class="mx-auto max-w-container px-gutter py-[88px] text-center">
    <h2 class="font-display text-[32px] font-black leading-[1.1] text-white sm:text-[44px]">{title}</h2>
    <p class="mx-auto mt-[18px] max-w-[600px] text-[19px] leading-relaxed text-salt-200">{description}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href={primaryHref} variant="primary">{primaryLabel}</Button>
      <Button href={secondaryHref} variant="inverse">{secondaryLabel}</Button>
    </div>
  </div>
</section>
