---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const reasons = [
  {
    icon: 'droplets',
    title: 'Low-Contact Precision Robotics',
    body: 'Walking on a roof or leaning on panels to clean them can crack cells and roof tiles. At Salt Spray Solar, we treat your system like a high-precision investment. We deploy lightweight robotic solar panel cleaners that use soft nylon rollers to glide across your array, so no one walks across your panels.',
  },
  {
    icon: 'scan-line',
    title: 'Data-Backed Infrared Thermal Analysis',
    body: 'We don’t guess your solar system’s health—we map it. Every project is backed by high-resolution thermal imaging drone audits. Our aerial infrared sweeps reveal hot spots, the heat signature of cracked or faulty cells, failing strings and other electrical faults that reduce output and can become safety risks. You receive a digital data report proving exactly where your system is losing power.',
  },
  {
    icon: 'gauge',
    title: 'Industrial-Grade 4-Stage RO/DI Water Filtration',
    body: 'Coastal salt-air film, industrial diesel soot, and bird droppings form a stubborn crust that regular town tap water cannot clean. In fact, tap water leaves behind calcium and iron minerals that can bake into energy-blocking scale. Our mobile trailer rigs carry custom, 4-stage Reverse Osmosis and Deionization (RO/DI) filtration carts, purifying on-site mains water to near-zero dissolved minerals. The glass dries spot-free.',
  },
  {
    icon: 'shield-check',
    title: 'Safety-First Work Practices',
    body: 'Safety is our baseline protocol. Salt Spray Solar carries $20 Million Public Liability Insurance. Our technicians hold the nationally recognised RIIWHS204E Work Safely at Heights unit of competency, and we work to SafeWork NSW guidance for work on roofs. We provide site-specific SWMS (Safe Work Method Statements) and strict Job Safety Analysis logs before mobilizing. By using remote-controlled crawlers instead of manual crews at roof edges, we reduce the height risks involved in cleaning your panels.',
  },
  {
    icon: 'badge-check',
    title: 'Direct Accountability: One Founder-Operator',
    body: 'When you hire Salt Spray Solar, your high-value asset is never passed off to third-party subcontractors or rotating crews. Every drone flight, water optimization run, and system diagnostic is executed directly by the founder and technical operator. You receive a clear, fixed-price quote and a singular point of master-craft accountability from the M1 corridor down to the metropolitan hubs.',
  },
];

const faqs = [
  {
    question: 'Why is robotic solar panel cleaning safer than manual pressure washing?',
    answer:
      'High-pressure washing can force moisture past the weatherproofing seals of solar panels, which can lead to corrosion and electrical faults. Manual cleaning can also mean people walking on the roof, which risks cracked tiles and leaks. Our robotic cleaners use soft brushes, gentle pressure and pure water with no chemical detergents, so no one has to walk across your panels.',
    open: true,
  },
  {
    question: 'Does Salt Spray Solar service commercial sites outside normal trading hours?',
    answer:
      'Yes. To reduce foot-traffic hazards around commercial facility entrances, school courtyards, or busy industrial loading bays, Salt Spray Solar schedules high-volume warehouse and strata assets during off-peak windows, including early mornings and weekends, with full WHS documentation prepared in advance.',
  },
  {
    question: 'Can coastal salt spray permanently damage my solar panels if not cleaned?',
    answer:
      'It can. Salt left baked onto the glass for long periods builds up into stubborn scale that is harder to remove and can affect the panel surface over time. Regular cleaning with pure water removes the salt film before it builds up.',
  },
];
---

<BaseLayout
  title="Why Salt Spray Solar"
  description="Why NSW property owners and facility managers choose Salt Spray Solar for robotic solar optimisation."
>
  <PageHero
    eyebrow="Why Salt Spray Solar"
    title="The Precision Edge in"
    emphasis="Solar Asset Optimization"
    sub="Why residential property owners and NSW facility managers choose Salt Spray Solar to safely recover lost energy yield, detect hidden electrical faults, and reduce the risks of working at heights."
  >
    <Fragment slot="actions">
      <Button href={site.bookHref} variant="primary">Get Your Price &amp; Book</Button>
      <Button href={site.assessmentHref} variant="outline">Request a Corporate Site Assessment &amp; SWMS Proposal</Button>
    </Fragment>
    <Photo slot="media" ratio="4x5" note="Founder-operator on site with drone and crawler, coastal roof behind, bright daylight." />
  </PageHero>

  <Section>
    <p class="eyebrow">The structural pillars of value</p>
    <h2 class="h2">Five reasons, one accountable operator</h2>
    <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {reasons.map((r, i) => <Card icon={r.icon} num={`0${i + 1}`} title={r.title}>{r.body}</Card>)}
    </div>
  </Section>

  <Section tone="salt">
    <div class="max-w-[928px]">
      <p class="eyebrow">FAQ</p>
      <h2 class="h2">Trust &amp; Credibility FAQs</h2>
      <FaqList items={faqs} />
    </div>
  </Section>

  <CtaBand
    title="Experience the Difference of Intelligent Solar Optimization."
    lede="Partner with a specialist robotic solar cleaning operator on the NSW coast."
    cards={[
      { label: 'Residential Roof Lines', tone: 'amber', href: site.bookHref, text: 'Get Your Price & Book' },
      { label: 'Commercial Infrastructure', tone: 'teal', href: site.assessmentHref, text: 'Request a Corporate Site Assessment & SWMS Proposal' },
    ]}
  />
</BaseLayout>
