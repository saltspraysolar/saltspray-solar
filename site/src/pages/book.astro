---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site } from '../data/site';

const features = [
  'Instant price, calculated from your details — not a guess.',
  'Pick your own time, no waiting on a call back.',
  'Small deposit secures your booking; balance due on the day.',
  'Clear price before any work starts. No hidden fees.',
  'Residential or commercial, one panel or a hundred.',
];
---

<BaseLayout
  title="Book Now — SaltSpray Solar"
  description="Get an instant price, pick a time and book your SaltSpray Solar clean online."
>
  <section class="bg-sand-100 px-gutter py-20">
    <div class="mx-auto max-w-container">
      <SectionHeader
        eyebrow="Book now"
        title="Get your price, pick a time, done"
        description="Punch in a few details about your system and our calculator gives you a price on the spot. Pick a time that suits, pop down a deposit to lock it in, and we'll see you then — no quotes-in-a-week, no waiting on a call back."
        center
      />
    </div>
  </section>

  <section class="px-gutter py-24">
    <div class="mx-auto flex max-w-container flex-wrap items-start gap-[72px]">
      <div class="min-w-0 flex-[1_1_460px]">
        <div class="flex aspect-[4/3] flex-col items-center justify-center gap-3 rounded-lg border border-dashed border-salt-300 bg-white p-10 text-center shadow-sm">
          <div class="h-[88px] w-[88px] rounded-lg border border-teal-300 bg-teal-100"></div>
          <p class="font-display text-xs font-bold uppercase tracking-[.14em] text-teal-700">App embed</p>
          <p class="max-w-[320px] text-[15px] leading-relaxed text-salt-600">Your quote, booking and deposit tool goes here — Stripe Payment Link for the deposit, Calendly for picking a time.</p>
        </div>
      </div>
      <div class="min-w-0 flex-[1_1_360px]">
        <ul class="flex flex-col gap-4">
          {features.map((feature) => (
            <li class="flex items-start gap-3.5 text-[17px] leading-relaxed text-navy-800">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-teal-300 bg-teal-100 font-bold text-teal-700">✓</span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
        <div class="mt-10 rounded-lg border border-salt-200 bg-sand-100 p-6">
          <p class="text-[17px] leading-relaxed text-navy-800">Prefer to talk it through first?</p>
          <p class="mt-2 font-display text-[15px] font-bold text-navy-800">
            Call <a href={site.phone.href} class="text-navy-600 hover:text-amber-600">{site.phone.display}</a> or email{' '}
            <a href={`mailto:${site.email}`} class="text-navy-600 hover:text-amber-600">{site.email}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
