---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Spot from '../components/Spot.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import CompareSlider from '../components/CompareSlider.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

// Before/after photos: put the files in public/images/ and set the paths here, e.g. '/images/before.jpg'.
// Leave a path empty to keep the labelled placeholder. Edit the caption and the three figures in the
// results panel below to match the real job.
const resultImages = { before: '', after: '' };

const pillars = [
  {
    icon: 'droplets',
    title: 'Autonomous Robotic Cleaning',
    body: 'We don’t do manual scrubbing or walking on your roof lines. Our lightweight robotic solar panel cleaners feature engineered nylon tracks and variable-speed roller brushes. Zero roof footprint. Zero risk of cracked tiles or sheet damage.',
  },
  {
    icon: 'scan-line',
    title: 'Thermal Imaging Drone Audits',
    body: 'Before a drop of water touches your roof, our advanced diagnostic drones map your system. Using infrared heat-mapping, we instantly pinpoint invisible micro-cracks, bypassed diodes, and electrical hot spots that are quietly killing your efficiency.',
  },
  {
    icon: 'gauge',
    title: 'Deionized Pure-Water Finish',
    body: 'Harsh tap water contains calcium and magnesium that bake under the Australian sun, creating permanent efficiency-blocking mineral scales. We feed our robots multi-stage, Reverse Osmosis Deionized (RO/DI) pure water to guarantee a spotless, 000-PPM streak-free finish.',
  },
  {
    icon: 'waves',
    title: 'Complete Marine Salt & Grime Eradication',
    body: 'Living near the NSW coastline means a microscopic layer of sticky salt crust forms on your glass weekly. Standard rain doesn’t wash this away; it simply smears it. Our robotic systems lift baked-on bird droppings, marine crust, and airborne pollution without using corrosive chemical detergents.',
  },
];

const proofs = [
  ['Trained to Work Safely at Heights:', 'Our technicians hold the nationally recognised RIIWHS204E Work Safely at Heights unit of competency and a current Construction White Card, and we work to SafeWork NSW guidance for work on roofs.'],
  ['$20M Liability Architecture:', 'Backed by comprehensive commercial-grade public liability insurance. Property and strata managers receive full SWMS documentation before we mobilize.'],
  ['Verifiable Proof of Yield:', 'We measure your inverter data before and after every single optimization cycle, handing you a complete, data-backed digital recovery report.'],
];

const faqs = [
  {
    question: 'Why should I choose robotic panel cleaning over standard pressure washing?',
    answer:
      'Standard high-pressure water blasting can crack solar glass templates, trigger micro-fractures inside the internal silicon cells, and easily force water past rubber seals, voiding your structural warranty. Salt Spray Solar utilizes specialized, ultra-lightweight robotic crawlers designed to apply precise, uniform pressure using warranty-safe nylon roller brushes, eliminating human foot-traffic damage entirely.',
    open: true,
  },
  {
    question: 'Do I need a thermal imaging drone solar inspection?',
    answer:
      'Yes. Solar panel degradation and cells shorting out happen silently under the glass. Our aerial infrared drones execute a thermal solar audit to reveal hot spots, cracked modules, and failing bypass string loops that are completely invisible to the naked eye. This ensures you catch critical faults before they cause permanent system failure or hazardous house fires.',
  },
  {
    question: 'Will utilizing your pure water systems void my manufacturer warranty?',
    answer:
      'No. Leading global solar brands strictly require multi-stage deionized (DI) pure water for cleaning maintenance. Because our RO/DI filtration cart strips out 100% of minerals, it leaves zero scaling behind, keeping your warranty pristine.',
  },
];
---

<BaseLayout
  title="Salt Spray Solar — Robotic Solar Panel Cleaning, Sydney to Newcastle"
  description="Robotic solar panel cleaning and thermal drone diagnostic audits across Sydney, the Central Coast and Newcastle."
>
  <PageHero
    eyebrow="Sydney · Central Coast · Newcastle"
    title="Stop Letting Grime Drain"
    emphasis="Your Solar Investment."
    sub="Salt Spray Solar delivers premium, robotic solar panel cleaning and thermal drone diagnostic audits across Sydney, the Central Coast, and Newcastle. We deploy advanced autonomous crawlers and infrared aerial tech to completely eliminate baked-on salt film, bird droppings, and industrial soot—recovering up to 30% of your lost energy yield without a single human stepping foot on your roof tiles."
  >
    <Fragment slot="actions">
      <Button href={site.bookHref} variant="primary">Calculate Your Robotic Clean &amp; Book Online</Button>
      <Button href={site.assessmentHref} variant="outline">Request a B2B Commercial Thermal Yield Audit</Button>
    </Fragment>
    <Photo slot="media" ratio="4x5" note="Robotic crawler mid-pass on a coastal array, roller brush and pure-water feed visible, bright daylight." />
  </PageHero>

  <section>
    <div class="mx-auto grid max-w-container gap-6 px-gutter pt-14 md:grid-cols-2">
      <a
        href={site.bookHref}
        class="flex flex-col gap-5 rounded-lg border border-t-[3px] border-salt-300 border-t-amber-500 bg-white p-6 text-navy-800 shadow-xs transition duration-200 hover:-translate-y-0.5 hover:shadow-md md:p-8"
      >
        <div class="flex items-center gap-[18px]">
          <Spot icon="calendar-check" />
          <span class="font-display text-xs font-bold uppercase tracking-[.14em] text-amber-700">Residential</span>
        </div>
        <span class="flex items-center justify-between gap-4 font-display text-xl font-black leading-[1.2] tracking-[-0.02em] md:text-2xl">
          I'm a Homeowner - Calculate My Price
          <Icon name="chevron-right" class="h-6 w-6 text-amber-600" />
        </span>
        <span class="border-t border-salt-200 pt-4 text-[13px] leading-[1.55] text-salt-600">
          To minimize local road emissions and protect fragile residential driveways, Salt Spray Solar utilizes an ultra-lightweight direct-feed trailer system that connects straight to your standard outdoor tap, purifying your water on-site.
        </span>
      </a>
      <a
        href={site.assessmentHref}
        class="flex flex-col gap-5 rounded-lg border border-t-[3px] border-navy-700 border-t-teal-300 bg-navy-800 p-6 text-white shadow-xs transition duration-200 hover:-translate-y-0.5 hover:shadow-md md:p-8"
      >
        <div class="flex items-center gap-[18px]">
          <Spot icon="building-2" tone="deep" />
          <span class="font-display text-xs font-bold uppercase tracking-[.14em] text-teal-300">Commercial &amp; strata</span>
        </div>
        <span class="flex items-center justify-between gap-4 font-display text-xl font-black leading-[1.2] tracking-[-0.02em] md:text-2xl">
          I Manage a Facility - Request a SWMS &amp; Audit Proposal
          <Icon name="chevron-right" class="h-6 w-6 text-amber-400" />
        </span>
        <span class="border-t border-white/15 pt-4 text-[13px] leading-[1.55] text-salt-200">Goes to the commercial intake form.</span>
      </a>
    </div>
  </section>

  <Section>
    <SectionHeader
      eyebrow="What we do"
      title="Advanced Solar Optimization, Powered by Intelligent Robotics"
      description="Four core pillars of asset protection, executed flawlessly in a single zero-liability site visit."
    />
    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {pillars.map((p, i) => <Card icon={p.icon} num={`0${i + 1}`} title={p.title}>{p.body}</Card>)}
    </div>
  </Section>

  <Section tone="deep">
    <div class="grid items-center gap-10 md:gap-16 lg:grid-cols-2">
      <div>
        <p class="eyebrow eyebrow-deep">Why Salt Spray Solar</p>
        <h2 class="h2 h2-light">Engineered For High-Yield Performance &amp; Strict WHS Compliance</h2>
        <p class="lede lede-light">We treat your residential or commercial solar asset like a high-precision investment, not a household chore.</p>
        <ul class="mt-[34px] flex flex-col gap-[22px]">
          {
            proofs.map(([lead, text]) => (
              <li class="flex items-start gap-4 border-t border-white/15 pt-[22px] leading-[1.62]">
                <Icon name="check" class="mt-[3px] h-5 w-5 text-amber-400" />
                <p><strong class="font-display font-bold text-white">{lead}</strong> {text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <Photo ratio="4x5" deep note="Thermal drone in flight over a commercial roof, or the infrared heat map it produces." />
    </div>
  </Section>

  <Section>
    <p class="eyebrow">Results</p>
    <h2 class="h2">Real Visual Proof. Real Financial Recovery.</h2>
    <p class="lede">Don't take our word for it—see the active solar yield recovery from real jobs across Terrigal, Newcastle, and Sydney.</p>
    <div class="mt-12 grid items-stretch gap-10 lg:grid-cols-[2fr_1fr]">
      <div class="flex min-w-0 flex-col gap-3.5">
        <CompareSlider beforeSrc={resultImages.before || undefined} afterSrc={resultImages.after || undefined} beforeNote="Array on arrival — salt film and droppings." afterNote="Same array after the robotic pure-water clean." />
        <p class="font-mono text-sm leading-normal text-salt-600">16.6kW Array — Multi-Storey Commercial Roof, Newcastle Port Zone.</p>
      </div>
      <div class="flex min-w-0 flex-col rounded-lg border border-salt-200 bg-sand-100">
        <div class="border-b border-sand-200 p-7">
          <div class="font-display text-[56px] font-black leading-none tracking-[-0.03em] text-navy-800">23%</div>
          <p class="mt-2.5">Immediate Efficiency Gain Captured</p>
        </div>
        <div class="border-b border-sand-200 p-7">
          <p class="font-display text-xs font-bold uppercase tracking-[.14em] text-salt-600">System Output Restored</p>
          <p class="mt-2.5 font-mono text-[22px] font-semibold text-teal-700">4.12 kW ➔ 5.07 kW</p>
        </div>
        <div class="p-7">
          <p class="font-display text-xs font-bold uppercase tracking-[.14em] text-salt-600">Estimated Household Savings</p>
          <p class="mt-2.5 font-mono text-[22px] font-semibold text-navy-800">$340+ per billing quarter.</p>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="salt">
    <div class="max-w-[928px]">
      <p class="eyebrow">FAQ</p>
      <h2 class="h2">Common questions</h2>
      <FaqList items={faqs} />
      <a href="/faq" class="mt-7 inline-flex items-center gap-2 font-display text-[15px] font-bold text-navy-600 hover:text-amber-600">
        See all questions <Icon name="chevron-right" class="h-4 w-4" />
      </a>
    </div>
  </Section>

  <CtaBand
    title="Stop Letting Grime Drain Your Solar Investment."
    lede="Calculate your robotic clean and book online, or request a commercial thermal yield audit."
    cards={[
      { label: 'Residential', tone: 'amber', href: site.bookHref, text: 'Calculate Your Robotic Clean & Book Online' },
      { label: 'Commercial & strata', tone: 'teal', href: site.assessmentHref, text: 'Request a B2B Commercial Thermal Yield Audit' },
    ]}
  />
</BaseLayout>
