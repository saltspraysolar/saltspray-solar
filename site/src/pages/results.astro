---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Results — SaltSpray Solar"
  description="Real before-and-after results from SaltSpray Solar's panel cleans across Sydney, the Central Coast and Newcastle."
>
  <section class="bg-sand-100 px-gutter py-20">
    <div class="mx-auto max-w-container">
      <SectionHeader
        eyebrow="Results"
        title="Real results, before and after"
        description="Dust, pollen, bird droppings and salt film sit directly on the glass and block light from reaching the cells underneath. A proper clean restores a clear surface so your system can actually do its job."
        center
      />
    </div>
  </section>

  <section class="px-gutter py-24">
    <div class="mx-auto max-w-container">
      <div class="mx-auto flex max-w-[560px] flex-col items-center gap-3 rounded-lg border border-dashed border-salt-300 bg-white p-12 text-center shadow-xs">
        <div class="h-[88px] w-[88px] rounded-lg border border-teal-300 bg-teal-100"></div>
        <p class="font-display text-xs font-bold uppercase tracking-[.14em] text-teal-700">Drag to see the difference</p>
        <p class="text-[19px] font-bold text-navy-800">Photos coming soon</p>
        <p class="max-w-[380px] text-[17px] leading-relaxed text-salt-600">Check back after our first jobs are done — we'll drop 3–5 real before/after pairs in here.</p>
      </div>
      <p class="mt-6 text-center text-[15px] font-bold text-salt-500">Real jobs, real panels, no stock photos.</p>
    </div>
  </section>

  <section class="bg-navy-900 px-gutter py-16 text-center text-white">
    <div class="mx-auto max-w-container">
      <p class="text-[19px] leading-relaxed text-salt-200">Want your roof looking like this?</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href={site.quoteHref} variant="primary">Get an Instant Quote →</Button>
      </div>
    </div>
  </section>
</BaseLayout>
