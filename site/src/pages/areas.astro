---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const regions = [
  {
    id: 'sydney',
    tab: 'Sydney Metropolitan Region',
    title: 'Sydney Metropolitan Region',
    suburbs:
      'Northern Beaches (Manly to Palm Beach), Eastern Suburbs (Bondi to Maroubra), Sutherland Shire, Hills District, and the Western Sydney Industrial Corridor (Parramatta, Penrith, Blacktown).',
    cta: 'Book a Robotic Clean in Sydney',
    factorIcon: 'building-2',
    factor:
      'Sydney systems face dual pressures. Coastal suburbs face marine salt spray that builds up on the glass, while Western Sydney arrays collect fine construction dust, traffic exhaust, and pollen films that shade cells.',
    solutionIcon: 'droplets',
    solution:
      'We deploy our ultra-lightweight robotic solar panel cleaners across complex multi-storey architectural homes and large industrial roof lines safely. Our 4-stage deionized pure-water trailer rigs deliver a spot-free, streak-free finish.',
  },
  {
    id: 'central-coast',
    tab: 'The Central Coast',
    title: 'The Central Coast',
    suburbs: 'Gosford, Wyong, Erina, Terrigal, Avoca Beach, Wamberal, The Entrance, and Tuggerah.',
    cta: 'Book a Robotic Clean on the Central Coast',
    factorIcon: 'waves',
    factor:
      'Sitting close to the ocean means sea breezes constantly mist arrays with salt air, which bakes into a thick, crusty scale under the hot sun. This coastal film acts like a tint on your glass, quietly cutting your yield.',
    solutionIcon: 'gauge',
    solution:
      'Salt Spray Solar is highly specialized in shifting stubborn maritime scaling. We connect directly to your local property tap on the Coast, purifying the water on-site down to pure, mineral-free liquid before sending our crawlers up to safely restore your investment.',
  },
  {
    id: 'newcastle',
    tab: 'Newcastle & Greater Hunter Region',
    title: 'Newcastle & Greater Hunter Region',
    suburbs:
      'Newcastle CBD, Newcastle East, Merewether, Adamstown, Mayfield, Lake Macquarie (Warners Bay, Charlestown), and the Port of Newcastle.',
    cta: 'Book a Robotic Clean in Newcastle',
    factorIcon: 'bird',
    factor:
      'Newcastle arrays face unique industrial challenges. Properties close to the port, rail corridors, and industrial hubs are vulnerable to microscopic coal dust, heavy commercial diesel soot, and massive bird nesting traffic along the coast. This organic and industrial grime creates severe cell shading, causing electrical “hot spots” that can degrade your panels permanently.',
    solutionIcon: 'scan-line',
    solution:
      'Before we clean a single panel in the Hunter, we launch high-resolution thermal imaging drone audits to check the condition of your system. Our infrared sweeps show hot spots from cracked cells, heavy shading and other faults, followed by a gentle robotic clean that follows your manufacturer’s cleaning instructions.',
  },
];

const faqs = [
  {
    question: 'Why is rain not enough to clean solar panels on the Central Coast or Newcastle?',
    answer:
      'Standard rainfall lacks the purity and pressure to dissolve baked-on environmental contaminants. On the Central Coast, rain simply spreads sticky marine salt films evenly across the glass rather than lifting them off, leaving a cloudy layer as it dries. In industrial zones like Newcastle, rain mixes with airborne diesel soot and coal dust, carrying it down the panel pitch where it pools into a thick, opaque “grime band” along the lower aluminum frame, which heavily bottlenecks daily energy output.',
    open: true,
  },
  {
    question: 'How much does a professional solar panel clean cost in Sydney vs Newcastle?',
    answer:
      'At Salt Spray Solar, we keep pricing transparent across all serviced NSW regions. Residential systems up to 12 panels feature a flat call-out and optimization fee of $150 to $180 AUD, inclusive of all regional travel along the M1 highway. Additional panels are budgeted on a clear, sliding scale of $8.00 to $15.00 AUD per panel, depending on height accessibility. Commercial or industrial warehouse operations receive custom tiered quotes based on total array volume and compliance logistics.',
  },
  {
    question: 'Do your solar optimization services follow SafeWork NSW safety guidance?',
    answer:
      'Yes. Salt Spray Solar takes safety seriously. Our solo operator holds the nationally recognised RIIWHS204E Work Safely at Heights unit of competency and a General Construction White Card, and we work to SafeWork NSW guidance for work on roofs. For every residential and commercial job across Sydney, the Central Coast, and Newcastle, we carry out a site risk assessment and supply site-specific SWMS documentation, and we carry $20 Million Public Liability Insurance.',
  },
];
---

<BaseLayout
  title="Service Areas — Sydney, Central Coast & Newcastle — Salt Spray Solar"
  description="Robotic solar panel cleaning across Sydney, the Central Coast, Newcastle and Lake Macquarie."
>
  <section class="border-b border-sand-200 bg-sand-100">
    <div class="mx-auto max-w-container px-gutter pb-12 pt-14 md:pb-16 md:pt-[88px]">
      <div class="max-w-[860px]">
        <p class="eyebrow">Service areas</p>
        <h1 class="h1">Professional Robotic Solar Cleaning <em>Across the NSW Coastal Corridor</em></h1>
        <p class="mt-6 max-w-[620px] text-[17px] leading-[1.68] md:text-[19px]">
          Restoring lost solar energy yield and executing precise thermal drone diagnostics from the beaches of Sydney, up through the Central Coast, to the industrial hubs of Newcastle and Lake Macquarie.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={site.bookHref} variant="primary">Get Your Price &amp; Book</Button>
        </div>
      </div>
      <div class="mt-14 grid gap-3 pb-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          regions.map((r, i) => (
            <a
              href={`#${r.id}`}
              class="flex min-h-16 items-center gap-3.5 rounded-lg border border-salt-300 bg-white px-5 py-3.5 font-display text-base font-bold leading-[1.3] text-navy-800 shadow-xs hover:bg-salt-50"
            >
              <span class="num num-amber">0{i + 1}</span>
              <span class="flex-1">{r.tab}</span>
              <Icon name="chevron-down" class="h-4 w-4 text-salt-500" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    regions.map((r, i) => (
      <section id={r.id} class={`section border-b border-salt-200 ${i === 1 ? 'bg-sand-100' : ''}`}>
        <div class="mx-auto grid max-w-container items-start gap-8 px-gutter md:gap-14 lg:grid-cols-[1fr_1.4fr]">
          <div class="flex flex-col gap-5">
            <span class="num num-amber">0{i + 1}</span>
            <h2 class="h2 mt-0">{r.title}</h2>
            <div class="border-t border-salt-200 pt-[18px]">
              <p class="font-display text-xs font-bold uppercase tracking-[.14em] text-salt-600">Target Suburbs / Service Footprint</p>
              <p class="mt-2.5 leading-[1.65]">{r.suburbs}</p>
            </div>
            <div>
              <Button href={site.bookHref} variant="primary">{r.cta}</Button>
            </div>
          </div>
          <div class="grid gap-6">
            <Card small icon={r.factorIcon} title="Local Environmental Factors">{r.factor}</Card>
            <Card small accent icon={r.solutionIcon} title="The Robotic Solution">{r.solution}</Card>
          </div>
        </div>
      </section>
    ))
  }

  <Section>
    {
      site.mapScriptUrl ? (
        <>
          <div id="saltspray-map" class="min-h-[420px] w-full overflow-hidden rounded-lg border border-salt-300 shadow-sm" />
          <script is:inline src={site.mapScriptUrl} async />
        </>
      ) : site.mapEmbedUrl ? (
        <iframe
          src={site.mapEmbedUrl}
          title="Salt Spray Solar service area map"
          class="aspect-[4/5] w-full rounded-lg border border-salt-300 shadow-sm md:aspect-[21/9]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        />
      ) : (
        <Photo ratio="21x9" deep label="Map embed placeholder · 21:9" note="Interactive Google Maps API Embed showing the distinct coverage radius running tightly from Sydney's south up the M1 corridor to the top of Lake Macquarie and Newcastle Port." />
      )
    }
    <p class="mt-6 max-w-[820px] text-[17px] leading-[1.65] md:text-[19px]">
      Don’t see your exact NSW suburb listed above? If you are located along or adjacent to the M1 Pacific Motorway corridor, Salt Spray Solar has you covered. As a solo technical operator, our fully equipped mobile trailer rig schedules weekly regional zone days for fixed-price service with no hidden highway travel fees.
    </p>
  </Section>

  <Section tone="salt">
    <div class="max-w-[928px]">
      <p class="eyebrow">FAQ</p>
      <h2 class="h2">Regional Search Intent FAQs</h2>
      <FaqList items={faqs} />
    </div>
  </Section>

  <CtaBand
    title="From Sydney to Newcastle, Stop Leaking Clean Energy to Environmental Grime."
    lede="Maximize your system's output with the corridor’s specialist robotic solar cleaning service."
    cards={[
      { label: 'Residential Properties', tone: 'amber', href: site.bookHref, text: 'Get Your Price & Book' },
      { label: 'Commercial Facilities', tone: 'teal', href: site.assessmentHref, text: 'Request an Infrared Site Yield Audit & Formal Proposal' },
    ]}
  />
</BaseLayout>
